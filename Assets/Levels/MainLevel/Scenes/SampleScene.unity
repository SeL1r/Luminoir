  m_text: "\u0421\u043B\u043E\u0432\u043E \u043F\u043B\u043E\u0442\u044C, \u0434\u0443\u0448\u0430
    \u2014 \u0441\u0442\u0435\u043A\u043B\u043E. \u0417\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u0439,
    \u0447\u0442\u043E \u043D\u0435 \u0432\u043F\u0443\u0449\u0435\u043D\u043E. \u041F\u0443\u0441\u0442\u044C
    \u0442\u0435\u043D\u044C \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F
    \u0432 \u0442\u0435\u043D\u0438. \u041F\u0443\u0441\u0442\u044C \u0436\u0438\u0432\u0451\u0442,
    \u043D\u043E \u043D\u0435 \u0436\u0438\u0432\u0451\u0442. \u042F \u043D\u0435
    \u043F\u043E\u0437\u0432\u043E\u043B\u044E \u0435\u0439 \u0443\u0439\u0442\u0438.
    \u042F \u043D\u0435 \u043F\u043E\u0437\u0432\u043E\u043B\u044E \u0435\u0439 \u0443\u0431\u0438\u0442\u044C
    \u043D\u0430\u0441."
