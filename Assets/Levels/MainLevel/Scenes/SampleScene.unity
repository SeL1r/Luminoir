  m_text: "\u041E\u043F\u044F\u0442\u044C \u044D\u0442\u043E\u0442 \u0441\u043E\u043D.
    \u041F\u0435\u043D\u0442\u0430\u0433\u0440\u0430\u043C\u043C\u0430 \u043D\u0430
    \u043F\u043E\u043B\u0443, \u0441\u0432\u0435\u0442, \u043A\u0430\u043A \u043E\u0442
    \u0441\u0432\u0435\u0447\u0435\u0439, \u0438 \u043A\u0443\u043A\u043B\u0430\u2026
    \u0441 \u0435\u0451 \u0433\u043B\u0430\u0437\u0430\u043C\u0438. \u042F \u043F\u0440\u043E\u0441\u044B\u043F\u0430\u044E\u0441\u044C,
    \u0430 \u0440\u0443\u043A\u0438 \u0432 \u043F\u043E\u0442\u0443, \u0441\u0435\u0440\u0434\u0446\u0435
    \u2014 \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u0445\u043E\u0447\u0435\u0442
    \u0432\u044B\u0440\u0432\u0430\u0442\u044C\u0441\u044F. \u041F\u043E\u0447\u0435\u043C\u0443
    \u044F \u043D\u0435 \u043C\u043E\u0433\u0443 \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u0442\u044C,
    \u0447\u0442\u043E \u044F \u0441\u0434\u0435\u043B\u0430\u043B? \u041F\u043E\u0447\u0435\u043C\u0443
    \u043E\u043D\u0430 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u043C\u0435\u043D\u044F
    \u0438\u0437\u043D\u0443\u0442\u0440\u0438 \u0441\u0442\u0435\u043A\u043B\u0430?"
