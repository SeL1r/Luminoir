  m_text: "\u041F\u0430\u043F\u0430, \u044F \u0437\u0434\u0435\u0441\u044C. \u042F
    \u043D\u0435 \u0443\u0448\u043B\u0430. \u042F \u043F\u0440\u043E\u0441\u0442\u043E
    \u0441\u0442\u0430\u043B\u0430 \u0442\u0438\u0445\u043E\u0439. \u041F\u043E\u0447\u0435\u043C\u0443
    \u0442\u044B \u0437\u0430\u043F\u0435\u0440 \u043C\u0435\u043D\u044F? \u042F
    \u043D\u0435 \u0445\u043E\u0442\u0435\u043B\u0430 \u0443\u043C\u0438\u0440\u0430\u0442\u044C.
    \u042F \u0445\u043E\u0442\u0435\u043B\u0430, \u0447\u0442\u043E\u0431\u044B \u0442\u044B
    \u043C\u0435\u043D\u044F \u043E\u0431\u043D\u044F\u043B."
