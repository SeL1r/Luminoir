  m_text: "\u041C\u044B \u0431\u044B\u043B\u0438 \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u044B.
    \u0414\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u043E\u043D\u0430
    \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0430 \u0441\u043F\u0430\u0442\u044C.
    \u0414\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u043D\u0430\u0447\u0430\u043B\u0430
    \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043D\u0430 \u044F\u0437\u044B\u043A\u0435,
    \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043D\u0435 \u0437\u043D\u0430\u0435\u0442.
    \u0414\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u044F \u043F\u043E\u043D\u044F\u043B
    \u2014 \u044D\u0442\u043E \u043D\u0435 \u043E\u043D\u0430. \u042D\u0442\u043E
    \u2014 \u043E\u043D\u043E."
  m_isRightToLeft: 0
