  m_text: "\u042F \u043B\u0433\u0430\u043B \u0441\u0435\u0431\u0435. \u042F \u043D\u0435
    \u0441\u043F\u0430\u0441\u0430\u043B \u0435\u0451. \u042F \u0443\u0431\u0438\u043B
    \u0435\u0451. \u042F \u0437\u0430\u043F\u0435\u0440 \u0434\u0443\u0448\u0443
    \u0436\u0438\u0432\u043E\u0433\u043E \u0440\u0435\u0431\u0451\u043D\u043A\u0430
    \u0432 \u043A\u0443\u043A\u043B\u0435, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E
    \u043D\u0435 \u043C\u043E\u0433 \u0432\u044B\u043D\u0435\u0441\u0442\u0438 \u0435\u0451
    \u0431\u043E\u043B\u0438. \u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E
    \u0431\u043E\u044F\u043B\u0441\u044F. \u0410 \u043F\u043E\u0442\u043E\u043C\u2026
    \u043E\u043D\u0430 \u0432\u044B\u0448\u043B\u0430. \u041D\u0435 \u0438\u0437
    \u0442\u0435\u043B\u0430. \u0418\u0437 \u043A\u0443\u043A\u043B\u044B. \u0418
    \u0441\u043A\u0430\u0437\u0430\u043B\u0430: \u201C\u0422\u044B \u043D\u0435 \u043F\u0430\u043F\u0430.
    \u0422\u044B \u2014 \u0442\u044E\u0440\u044C\u043C\u0430.\u201D \u042F \u043D\u0435
    \u043F\u043E\u043C\u043D\u044E, \u043A\u0430\u043A \u0443\u043C\u0435\u0440.
    \u041D\u043E \u044F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E \u2014 \u043E\u043D
    \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F. \u0422\u043E\u0442, \u043A\u0435\u043C
    \u044F \u0431\u044B\u043B. \u0422\u043E\u0442, \u043A\u0442\u043E \u043D\u0435
    \u0437\u043D\u0430\u043B. \u041E\u043D \u043F\u0440\u0438\u0434\u0451\u0442 \u0441\u044E\u0434\u0430.
    \u0418 \u044F \u043F\u043E\u043A\u0430\u0436\u0443 \u0435\u043C\u0443 \u043F\u0440\u0430\u0432\u0434\u0443."
