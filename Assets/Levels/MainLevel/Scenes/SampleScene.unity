  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041F\u0430\u0446\u0438\u0435\u043D\u0442 47. \u041C\u0443\u0436\u0447\u0438\u043D\u0430,
    42 \u0433\u043E\u0434\u0430. \u0423\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442,
    \u0447\u0442\u043E \u0434\u043E\u0447\u044C \u201C\u0437\u0430\u0440\u0430\u0436\u0435\u043D\u0430\u201D.
    \u0413\u043E\u0432\u043E\u0440\u0438\u0442 \u043E \u201C\u0434\u0443\u0445\u0430\u0445
    \u0432 \u0434\u0435\u0442\u044F\u0445\u201D, \u201C\u0441\u043D\u044F\u0442\u0438\u0438
    \u043F\u043E\u0440\u0447\u0438\u201D. \u041E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u043E\u0442 \u043C\u0435\u0434\u0438\u043A\u0430\u043C\u0435\u043D\u0442\u043E\u0432.
    \u041F\u044B\u0442\u0430\u0435\u0442\u0441\u044F \u201C\u043E\u0447\u0438\u0441\u0442\u0438\u0442\u044C\u201D
    \u0440\u0435\u0431\u0451\u043D\u043A\u0430. \u0421\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435
    \u0434\u043E\u0447\u0435\u0440\u0438 \u0443\u0445\u0443\u0434\u0448\u0430\u0435\u0442\u0441\u044F
    \u2014 \u043E\u043D\u0430 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0430
    \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C. \u0420\u043E\u0434\u0438\u0442\u0435\u043B\u044C
    \u0432 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438 \u043A\u0430\u0442\u0430\u0442\u043E\u043D\u0438\u0438.
    \u041D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043E \u043F\u0440\u0438\u043D\u0443\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
    \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435."
